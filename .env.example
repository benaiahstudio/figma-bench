# Set these in your shell environment. None are required if the defaults fit.
# Path to the compiled bridge MCP server (the stdio entry point).
FIGMA_BRIDGE_SERVER=
# Folder holding figma-render.mjs (the rendering helper of the toolkit).
FIGMA_TOOLKIT_DIR=
# Python used for the optional CLIP score.
BENCH_PYTHON=
# How many runs per frame and tool count as complete in the report (default 3).
BENCH_EXPECTED_RUNS=3
